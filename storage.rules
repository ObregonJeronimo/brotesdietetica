rules_version = '2';

/*
 * BROTES DIETÉTICA — REGLAS DE FIREBASE STORAGE
 * =============================================================================
 * IMPORTANTE: el proyecto YERCO NO tenía este archivo. Sin reglas propias,
 * Storage arranca con las reglas por defecto (solo usuarios autenticados, o
 * directamente todo denegado según la versión), y la subida de imágenes de
 * productos desde /admin falla con "storage/unauthorized".
 *
 * Modelo:
 *   - LECTURA pública: las fotos de productos y del sitio se muestran en la
 *     tienda, que es pública.
 *   - ESCRITURA solo admins, con límite de tamaño y validación de tipo, para
 *     que nadie use el bucket como hosting gratis.
 *
 * Desplegar con:  firebase deploy --only storage
 *
 * SOBRE QUIEN ES ADMIN ACA:
 * Storage no puede leer Firestore, asi que no puede consultar la coleccion
 * /admins como hacen las reglas de Firestore. Se resuelve con un custom claim:
 * la Cloud Function sincronizarClaimAdmin marca `admin:true` en el token de la
 * persona cuando se la agrega desde el panel, y se lo saca cuando se la quita.
 *
 * Consecuencia practica: un admin nuevo que YA estaba logueado necesita cerrar
 * sesion y volver a entrar para poder subir imagenes, porque el claim viaja en
 * el token y el token se emite al iniciar sesion. El resto del panel le funciona
 * al instante, porque eso lo resuelve Firestore leyendo /admins.
 *
 * El dueño queda fijo abajo como salida de emergencia, igual que en
 * firestore.rules: si el claim no se llego a aplicar, alguien tiene que poder
 * subir una imagen.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == 'jeroobregon03@gmail.com'
      );
    }

    function esImagenValida() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 6 * 1024 * 1024;
    }

    /* Fotos de productos (las sube el admin desde el panel) */
    match /productos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && esImagenValida();
      allow delete: if isAdmin();
    }

    /* Imágenes del sitio: hero, CTA y los 3 logos (Editor Web) */
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && esImagenValida();
      allow delete: if isAdmin();
    }

    /* Comprobantes / logo y QR de la factura */
    match /factura/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && esImagenValida();
      allow delete: if isAdmin();
    }

    /* El logo de la factura se sube a config/logo-factura.jpg (ver admin.html,
       saveFacturaFromEditor). No estaba contemplado en ninguna regla, asi que caia
       en el cierre de abajo y la subida fallaba con "storage/unauthorized". */
    match /config/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && esImagenValida();
      allow delete: if isAdmin();
    }

    /* Facturas y remitos de las compras a proveedores.
       DOS DIFERENCIAS con todo lo de arriba, a proposito:

       1) La LECTURA no es publica. Las fotos de productos se muestran en la
          tienda, por eso van abiertas; una factura de proveedor es un documento
          interno del comercio, con precios de costo y datos del proveedor
          adentro. Publica seria regalar la estructura de costos a cualquiera
          que adivine la URL.

       2) Se aceptan PDF ademas de imagenes: la mitad de los proveedores manda
          la factura en PDF y no como foto. */
    match /compras/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    /* Todo lo demás: cerrado. Sin esta regla, cualquier ruta nueva que agregue
       el panel en el futuro quedaría sin cubrir y Storage la denegaría igual,
       pero dejarlo explícito evita sorpresas. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
