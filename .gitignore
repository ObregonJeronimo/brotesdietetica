node_modules/

# Vercel / Firebase CLI
.vercel/
.firebase/
firebase-debug.log
firebase-debug.*.log
*.local

# Logs y basura de editor
*.log
.DS_Store
Thumbs.db

# Nunca commitear credenciales de servidor.
# La clave de cuenta de servicio de Firebase da acceso TOTAL al proyecto
# (ignora firestore.rules). Si alguna vez descargas una, va acá.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
.env
.env.*

# Bancos de prueba locales: montan los modulos del panel contra un Firestore
# falso. No deben desplegarse: el sitio es estatico y publico.
_test-*.html
respaldo-limpieza-*.json
productos-pag*.xlsx
DUDAS-CARGA-PRODUCTOS.txt

# Migracion FRUTICOR: los scripts SI, los datos NO.
# fruticor.json trae el catalogo y los COSTOS de YERCO, que es otro cliente.
# Se regeneran con: node migracion/dump.js
migracion/*.json
migracion/*.csv
migracion/*.txt

# Excepcion: lista1.txt NO se regenera con dump.js. Es la transcripcion a mano de
# las 16 fotos del reporte del sistema viejo, y de ahi salieron los 373 precios que
# faltaban (§1-bis I). Si se pierde, se pierden 16 fotos de tipeo. No expone nada:
# son codigos internos -los que el propio comercio imprime en sus etiquetas- y
# precios de VENTA, que ya estan publicos en la tienda. Ningun costo.
!migracion/lista1.txt
